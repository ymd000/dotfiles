[alias]
	# Basic commands
	st = status
	c = commit
	a = add
	ps = push
	pl = pull

	# Branch operations
	co = checkout
	br = branch

	# Useful shortcuts
	cm = commit -m
	ca = commit --amend
	aa = add --all

	# Log and history
	lg = log --oneline --graph --decorate
	ll = log --pretty=format:'%C(yellow)%h%Creset %C(cyan)%ad%Creset | %s %C(green)(%an)%Creset' --date=short

	# Diff
	df = diff
	dc = diff --cached

	# Stash
	stl = stash list
	stp = stash pop

[core]
	editor = nvim

[pull]
	rebase = true
