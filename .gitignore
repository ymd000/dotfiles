# 最初にすべての階層のファイルを無視します
# 階層は必要なだけ追加する
### all ignore ###
/*
/.**

# .gitignoreは上から解釈されていくので
# 管理対象のファイルをホワイトリストのように追記します
### not ignore ###
!/bin/
!/bin/**
!/.config/nvim/
!/.config/nvim/**
!/.config/lazygit/
!/.config/lazygit/**

# KDE Plasma
!/.config/kde/
!/.config/kde/**

# fcitx5
!/.config/fcitx5/
!/.config/fcitx5/config
!/.config/fcitx5/profile

# autostart
!/.config/autostart/
!/.config/autostart/fcitx5-wayland-launcher.desktop

!.gitignore
!.tmux.conf
!.zshrc
!.p10k.zsh
!.gitconfig_shared
